        "integrable_truncation_tail_two": {
          "completeAcceptedSourceDeclaration": "theorem integrable_truncation_tail_two (ν : Measure ℝ)\n    (h2 : Integrable (fun z : ℝ => z ^ 2) ν) (a : ℝ) (ha : 0 < a) :\n    Integrable (fun z : ℝ => if 1 / a < |z| then z ^ 2 else 0) ν",
          "declarationSHA256": "0f0c36eb7e1da20b0df2fa359f896ce8d68ed65440bb78fda6d7abf1c9596a47",
