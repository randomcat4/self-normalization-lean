        "truncationBudget_decomposition": {
          "completeAcceptedSourceDeclaration": "theorem truncationBudget_decomposition (ν : Measure ℝ) (n : ℕ)\n    (h2 : Integrable (fun z : ℝ => z ^ 2) ν) (t : ℝ) (ht : -1 < t) :\n    truncationBudget ν n t =\n      (1 + t) ^ 3 * ((n : ℝ) *\n        ∫ z : ℝ, if |z| ≤ 1 / (1 + t) then |z| ^ 3 else 0 ∂ν) +\n      (1 + t) ^ 2 * ((n : ℝ) *\n        ∫ z : ℝ, if 1 / (1 + t) < |z| then z ^ 2 else 0 ∂ν)",
          "declarationSHA256": "6ec1b572753602cd4cf5d44fbdd9f6792266d580c951ac75d621bf781b9ee033",
