          "declarationSHA256": "f8de64237aa6c0a12a97263be72b0d6161124ec94c76a68e9c722cbb8e6cf832",
          "completeSourceInterfaceRead": true,
          "transparentValueRead": false
        },
        "truncationBudget_scale_one_le": {
          "completeAcceptedSourceDeclaration": "theorem truncationBudget_scale_one_le (ν : Measure ℝ) (n : ℕ)\n    (h2 : Integrable (fun z : ℝ => z ^ 2) ν) (t c : ℝ) (hc : 1 ≤ c) :\n    c ^ 2 * truncationBudget ν n t ≤\n        truncationBudget ν n (c * (1 + t) - 1) ∧\n      truncationBudget ν n (c * (1 + t) - 1) ≤\n        c ^ 3 * truncationBudget ν n t",
          "declarationSHA256": "090e14d1c39ee8853a3ad4d8d69689aad01252268c27db3bcb7159eea60a2ee8",
          "completeSourceInterfaceRead": true,
