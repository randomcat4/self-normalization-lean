  "full_public_raw_contracts": {
    "sparseLabelMeasure": "def sparseLabelMeasure (α : ℝ) (x : ℕ → ℝ) (N : ℕ → ℕ) : Measure ℕ :=\n  Measure.sum fun j : ℕ => ENNReal.ofReal (sparseLabelMass α x N j) • Measure.dirac j",
    "sparseLabelMeasure_probability": "theorem sparseLabelMeasure_probability :\n  ∀ (α : ℝ) (x : ℕ → ℝ) (N : ℕ → ℕ),\n  IsProbabilityMeasure (sparseLabelMeasure α x N)",
    "sparseLabelMeasure_singleton": "theorem sparseLabelMeasure_singleton :\n  ∀ (α : ℝ) (x : ℕ → ℝ) (N : ℕ → ℕ) (j : ℕ),\n  sparseLabelMeasure α x N {j} = ENNReal.ofReal (sparseLabelMass α x N j)",
    "sparseLabelMeasure_real_singleton": "theorem sparseLabelMeasure_real_singleton :\n  ∀ (α : ℝ) (x : ℕ → ℝ) (N : ℕ → ℕ) (j : ℕ),\n  (sparseLabelMeasure α x N).real {j} = sparseLabelMass α x N j",
    "sparseLabelMeasure_Iio": "theorem sparseLabelMeasure_Iio :\n  ∀ (α : ℝ) (x : ℕ → ℝ) (N : ℕ → ℕ) (j : ℕ),\n  sparseLabelMeasure α x N (Set.Iio j) = ENNReal.ofReal (sparsePriorMass α x N j)",
    "sparseLabelMeasure_real_Iio": "theorem sparseLabelMeasure_real_Iio :\n  ∀ (α : ℝ) (x : ℕ → ℝ) (N : ℕ → ℕ) (j : ℕ),\n  (sparseLabelMeasure α x N).real (Set.Iio j) = sparsePriorMass α x N j",
    "sparseLabelMeasure_Ici": "theorem sparseLabelMeasure_Ici :\n  ∀ (α : ℝ) (x : ℕ → ℝ) (N : ℕ → ℕ) (j : ℕ),\n  1 ≤ j →\n  sparseLabelMeasure α x N (Set.Ici j) = ENNReal.ofReal (sparseHighMass α x N j)",
    "sparseLabelMeasure_real_Ici": "theorem sparseLabelMeasure_real_Ici :\n  ∀ (α : ℝ) (x : ℕ → ℝ) (N : ℕ → ℕ) (j : ℕ),\n  1 ≤ j →\n  (sparseLabelMeasure α x N).real (Set.Ici j) = sparseHighMass α x N j",
    "integrable_sparseLabelMeasure_iff": "theorem integrable_sparseLabelMeasure_iff :\n  ∀ (α : ℝ) (x : ℕ → ℝ) (N : ℕ → ℕ) (f : ℕ → ℝ),\n  Integrable f (sparseLabelMeasure α x N) ↔\n    Summable (fun j : ℕ => sparseLabelMass α x N j * ‖f j‖)",
    "integral_sparseLabelMeasure": "theorem integral_sparseLabelMeasure :\n  ∀ (α : ℝ) (x : ℕ → ℝ) (N : ℕ → ℕ) (f : ℕ → ℝ),\n  Integrable f (sparseLabelMeasure α x N) →\n  (∫ j, f j ∂(sparseLabelMeasure α x N)) =\n    ∑' j : ℕ, sparseLabelMass α x N j * f j",
    "tendsto_sparseLabelMeasure_high_mass_zero": "theorem tendsto_sparseLabelMeasure_high_mass_zero :\n  ∀ (α : ℝ) (x : ℕ → ℝ) (N : ℕ → ℕ),\n  Tendsto (fun j : ℕ => (sparseLabelMeasure α x N).real (Set.Ici j))\n    atTop (nhds 0)",
    "tendsto_sparseLabelMeasure_high_mass_cost_zero": "theorem tendsto_sparseLabelMeasure_high_mass_cost_zero :\n  ∀ (α : ℝ) (x : ℕ → ℝ) (N : ℕ → ℕ),\n  SparseSelectionCore α x N →\n  Tendsto (fun j : ℕ => (N j : ℝ) *\n    (sparseLabelMeasure α x N).real (Set.Ici j))\n    atTop (nhds 0)",
    "tendsto_sparseLabelMeasure_low_mass_one": "theorem tendsto_sparseLabelMeasure_low_mass_one :\n  ∀ (α : ℝ) (x : ℕ → ℝ) (N : ℕ → ℕ),\n  Tendsto (fun j : ℕ => (sparseLabelMeasure α x N).real (Set.Iio j))\n    atTop (nhds 1)",
    "tendsto_sparseLabelMeasure_background_power_one": "theorem tendsto_sparseLabelMeasure_background_power_one :\n  ∀ (α : ℝ) (x : ℕ → ℝ) (N : ℕ → ℕ),\n  SparseSelectionCore α x N →\n  Tendsto (fun j : ℕ => ((sparseLabelMeasure α x N).real (Set.Iio j)) ^ (2 * (N j - 2)))\n    atTop (nhds 1)"
  },
