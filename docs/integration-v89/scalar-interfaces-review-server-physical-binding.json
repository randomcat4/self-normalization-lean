  "native_private_name_lines_10_35": [
    "10: public import Init.Data.Option.Coe",
    "11: ",
    "12: public section",
    "13: ",
    "14: namespace Lean",
    "15: ",
    "16: /-! # Private name support.",
    "17: ",
    "18:    Suppose the user marks as declaration `n` as private. Then, we create",
    "19:    the name: `_private.<module_name>.0 ++ n`.",
    "20:    We say `_private.<module_name>.0` is the \"private prefix\"",
    "21: ",
    "22:    We assume that `n` is a valid user name and does not contain",
    "23:    `Name.num` constructors. Thus, we can easily convert from",
    "24:    private internal name to the user given name.",
    "25: -/",
    "26: ",
    "27: def privateHeader : Name := `_private",
    "28: ",
    "29: def mkPrivateNameCore (mainModule : Name) (n : Name) : Name :=",
    "30:   Name.mkNum (privateHeader ++ mainModule) 0 ++ n",
    "31: ",
    "32: def isPrivateName : Name → Bool",
    "33:   | n@(.str p _) => n == privateHeader || isPrivateName p",
    "34:   | .num p _     => isPrivateName p",
    "35:   | _            => false"
  ],
