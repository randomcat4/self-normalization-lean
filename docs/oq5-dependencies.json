  "root": {
    "name": "OQ5.P35.FixedLawCounterexample",
    "quantifier_order": "One fixed real law and one fixed symmetric Borel kernel before all n; one infinite iid sequence; every fixed n>=3 has positive R almost surely; explicit full x_n and explicit subsequence n_j",
    "law": "P(C=0)=16382/16383; P(C=j)=2^(-14j) for j>=1; A independent Uniform[-1,1]; X=3C+A",
    "kernel": "h=A+Aprime+d_C+d_Cprime-Z*Zprime; Z=2^(5C)-mu on C>=1, Z=-mu on C=0; mu=1/511; d_0=0; d_j=(4^j-1)*(2^(5j)-mu)^2/((4^j)^4-2)",
    "sequence": "x_n=n^(3/20)/16; b_n=2*x_n; k_j=4^j; n_j=k_j^4, j>=1",
    "moments": [
      "E h^2 < infinity",
      "E g = 0",
      "0 < E g^2 < infinity",
      "E |g|^3 < infinity",
      "E Z = 0",
      "E Z^2 = 1/15 - 1/511^2 > 0"
    ],
    "residual": "r=-Z*Zprime; exact canonical rank one; only nonzero eigenvalue -E Z^2",
    "studentizer": "R_n^2=4*(n-1)/(n-2)^2*sum_i(q_i-U_n)^2; T_n=sqrt(n)*(U_n-theta)/R_n; T_n=0 if R_n=0",
    "conclusions": [
      "for every fixed n>=3, P(R_n>0)=1",
      "x_n -> infinity and x_n=o(n^(1/6))",
      "along j->infinity: log P(T_nj>=x_nj)/(-x_nj^2/2) -> 0",
      "along j->infinity: P(T_nj>=x_nj)/Psi(x_nj) -> +infinity",
      "full b_n=2*x_n witnesses failure of uniform Gaussian ratio on [0,b_n)"
    ],
    "no_claim_of_full_n_ratio_limits": true
  },
