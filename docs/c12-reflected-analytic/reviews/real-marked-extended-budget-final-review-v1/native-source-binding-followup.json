      "excerpts": [
        {
          "start": 18,
          "end": 22,
          "text": "abbrev Path (n : ℕ) := Fin n → ℝ\n\nvariable {n : ℕ}\n\n/-- Sum of the first k coordinates, saturated at the path length. -/"
        },
        {
          "start": 23,
          "end": 27,
          "text": "def prefixSum (a : Path n) (k : ℕ) : ℝ :=\n  ∑ i ∈ Finset.univ.filter (fun i : Fin n => i.val < k), a i\n\n/-- Actual squared coordinates in the first k positions. -/\ndef prefixSquares (a : Path n) (k : ℕ) : ℝ :="
        },
        {
          "start": 31,
          "end": 35,
          "text": "def energy (a : Path n) : ℝ := ∑ i, (a i) ^ 2\n\n@[simp] theorem prefixSum_zero (a : Path n) : prefixSum a 0 = 0 := by\n  simp [prefixSum]\n"
        },
        {
          "start": 39,
          "end": 43,
          "text": "@[simp] theorem prefixSum_length (a : Path n) : prefixSum a n = ∑ i, a i := by\n  unfold prefixSum\n  rw [Finset.filter_eq_self.mpr (fun i _ => i.is_lt)]\n\n@[simp] theorem prefixSquares_length (a : Path n) : prefixSquares a n = energy a := by"
        }
      ]
    },
    "Shao/Probability/SourceSuffixMomentBudgets.lean": {
      "remotePath": "/root/rivermind-data/shao-lean-20261021/workspaces/common-suffix-moment-budgets-v73/Shao/Probability/SourceSuffixMomentBudgets.lean",
      "bytes": 147353,
      "sha256": "c0457040fec0cee18355f5028c7731e0ad8525deee28185aa0cf3b7a088d3c7b",
      "excerpts": [
        {
          "start": 241,
          "end": 259,
          "text": "theorem raw_gaussian_damped_coordinate_factors :\n    let lambda : ℝ := (1 - Real.exp (-2)) / 16\n    let c : ℝ := (1 - Real.exp (-2)) / 8\n    0 < lambda ∧ 0 < c ∧\n      ∀ (nu : Measure ℝ) [IsProbabilityMeasure nu],\n        Integrable (fun z : ℝ => z ^ 2) nu →\n        (∫ z : ℝ, z ∂nu) = 0 → (∫ z : ℝ, z ^ 2 ∂nu) = 1 →\n        ∀ (b s : ℝ), 0 < b → 0 < s → s ≤ 2 / b →\n          let retained : ℝ := ∫ z : ℝ, if z ^ 2 ≤ b then z ^ 2 else 0 ∂nu\n          let gamma : ℝ := if (1 / 2 : ℝ) ≤ retained then -c else 1\n          let a3 : ℝ → ℝ := fun u => ∫ z : ℝ, |z| ^ 3 * Real.exp (-u * z ^ 2) ∂nu\n          Integrable (fun z : ℝ => |z| ^ 3 * Real.exp (-(s / 2) * z ^ 2)) nu ∧\n            ∀ epsilon : ℝ, (epsilon = 1 ∨ epsilon = -1) →\n              let weight : ℝ → ℝ := fun z =>\n                Real.exp (-s * z ^ 2 + epsilon * lambda * Real.sqrt s * z)\n              Integrable weight nu ∧ Integrable (fun z => |z| ^ 3 * weight z) nu ∧\n                (∫ z : ℝ, weight z ∂nu) ≤ Real.exp (gamma * s) ∧\n                (∫ z : ℝ, |z| ^ 3 * weight z ∂nu) ≤\n                  Real.exp (lambda ^ 2 / 2) * a3 (s / 2) := by"
        }
      ]
    }
