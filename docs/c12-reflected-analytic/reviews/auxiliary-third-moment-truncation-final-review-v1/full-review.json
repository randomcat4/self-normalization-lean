  "perOwnerCoverage": [
    {
      "name": "Shao.C2.AuxiliaryThirdMomentTruncation.auxiliary_actual_third_moment_retains_half",
      "owner": "Shao.C2.AuxiliaryThirdMomentTruncation",
      "kind": "theorem",
      "sourceLine": 9,
      "sourceToStatement": "任意实际实数概率律，显式有限二/三阶绝对矩与真实二阶积分1；beta是真实绝对三阶积分，字面截止4beta²严格正，真实弱截止保留二阶积分至少半。辅助律的有限3不增加原始根假设。",
      "actualType": "完整8803字节逐一阅读，标准Real空间/实例、nu概率实例、h2/h3/hNorm、beta局部let、真实Bochner积分与实数1/2；无中心化/对称性/支撑/尾界隐藏前提。",
      "proof": [
        "精确已合格旧unit152公开头给beta>=1，因此beta>0、2beta>0、4beta²>0。",
        "R为真实if保留函数；可测比较集与Measurable.ite给可测，Integrable.mono'以|R|<=z²给真实可积性。",
        "截止内减去非负绝对立方比值；截止外用平方单调性推出|z|>2beta，乘非负z²并除正2beta给z²<=|z|³/(2beta)，由此全部点态下界。",
        "h3.div_const与h2.sub给下界可积，integral_mono双侧可积性齐全；Pi.sub_apply后以integral_sub/div和hNorm计算实际下界1-beta/(2beta)。",
        "分母非零由hDen，div_eq_iff与ring给beta/(2beta)=1/2，定义相等转换回实际目标。"
      ],
      "boundaryReview": [
        "弱截止等号保留，z0全覆盖。",
        "任意原子/不对称/非中心化概率律允许；delta1边界一致；delta0不满足hNorm。",
        "beta0不可能，所有分母正，不利用不可积Bochner默认0。"
      ],
      "axioms": [
        "propext",
        "Classical.choice",
        "Quot.sound"
      ],
      "semanticProofTypeInterfaceAXCoverage": "COMPLETE"
    }
  ],
