    {
      "start": 1275,
      "end": 1275,
      "text": "@[to_additive] lemma mabs_pow (n : ℕ) (a : G) : |a ^ n|ₘ = |a|ₘ ^ n := by"
    },
    {
      "start": 1276,
      "end": 1276,
      "text": "  obtain ha | ha := le_total a 1"
