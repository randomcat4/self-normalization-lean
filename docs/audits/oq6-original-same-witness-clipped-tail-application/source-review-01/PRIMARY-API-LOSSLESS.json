      "end": 1198,
      "text": "open MeasureTheory ProbabilityTheory"
    },
    {
      "start": 1199,
      "end": 1199,
      "text": "open scoped BigOperators Classical Topology"
    },
    {
      "start": 1200,
      "end": 1200,
      "text": "namespace Shao.OQ6.NormalizedIntegrableTailAssembly"
    },
    {
      "start": 1201,
      "end": 1201,
      "text": "noncomputable section"
    },
    {
      "start": 1202,
      "end": 1202,
      "text": "def ScalarShaoZhouFiniteCostTailInput"
    },
    {
      "start": 1203,
      "end": 1203,
      "text": "    (cSZ C1 C2 C3 C4 : ℝ) : Prop :="
    },
    {
      "start": 1204,
      "end": 1204,
      "text": "  0 < cSZ ∧ 0 < C1 ∧ 0 < C2 ∧ 0 < C3 ∧ 0 < C4 ∧"
    },
    {
      "start": 1205,
      "end": 1205,
      "text": "  ∀ {Ω : Type u} [MeasurableSpace Ω]"
    },
    {
      "start": 1206,
      "end": 1206,
      "text": "    (ν : Measure Ω) [IsProbabilityMeasure ν]"
    },
    {
      "start": 1207,
      "end": 1207,
      "text": "    (n : ℕ) (hn : 1 ≤ n) (ζ : Fin n → Ω → ℝ)"
    },
    {
      "start": 1208,
      "end": 1208,
      "text": "    (F1 F2 FA FB : (Fin n → ℝ) → ℝ)"
    },
    {
      "start": 1209,
      "end": 1209,
      "text": "    (FAdelete FBdelete : ∀ i : Fin n, ({j : Fin n // j ≠ i} → ℝ) → ℝ)"
    },
    {
      "start": 1210,
      "end": 1210,
      "text": "    (hζ : ∀ i : Fin n, Measurable (ζ i))"
    },
    {
      "start": 1211,
      "end": 1211,
      "text": "    (hζindep : iIndepFun ζ ν)"
    },
    {
      "start": 1212,
      "end": 1212,
      "text": "    (hζ2 : ∀ i : Fin n, MemLp (ζ i) 2 ν)"
    },
    {
      "start": 1213,
      "end": 1213,
      "text": "    (hζmean : ∀ i : Fin n, (∫ ω, ζ i ω ∂ν) = 0)"
    },
    {
      "start": 1214,
      "end": 1214,
      "text": "    (hζenergy : (∑ i : Fin n, ∫ ω, (ζ i ω) ^ 2 ∂ν) = 1)"
    },
    {
      "start": 1215,
      "end": 1215,
      "text": "    (hF1 : Measurable[borel (Fin n → ℝ), borel ℝ] F1)"
    },
    {
      "start": 1216,
      "end": 1216,
      "text": "    (hF2 : Measurable[borel (Fin n → ℝ), borel ℝ] F2)"
    },
    {
      "start": 1217,
      "end": 1217,
      "text": "    (hFA : Measurable[borel (Fin n → ℝ), borel ℝ] FA)"
    },
    {
      "start": 1218,
      "end": 1218,
      "text": "    (hFB : Measurable[borel (Fin n → ℝ), borel ℝ] FB)"
    },
    {
      "start": 1219,
      "end": 1219,
      "text": "    (hFAdelete : ∀ i : Fin n,"
    },
    {
      "start": 1220,
      "end": 1220,
      "text": "      Measurable[borel ({j : Fin n // j ≠ i} → ℝ), borel ℝ] (FAdelete i))"
    },
    {
      "start": 1221,
      "end": 1221,
      "text": "    (hFBdelete : ∀ i : Fin n,"
    },
    {
      "start": 1222,
      "end": 1222,
      "text": "      Measurable[borel ({j : Fin n // j ≠ i} → ℝ), borel ℝ] (FBdelete i))"
    },
    {
      "start": 1223,
      "end": 1223,
      "text": "    (x : ℝ),"
    },
    {
      "start": 1224,
      "end": 1224,
      "text": "    let C : Ω → (Fin n → ℝ) := fun ω i => ζ i ω"
    },
    {
      "start": 1225,
      "end": 1225,
      "text": "    let D1 : Ω → ℝ := fun ω => F1 (C ω)"
    },
    {
      "start": 1226,
      "end": 1226,
      "text": "    let D2 : Ω → ℝ := fun ω => F2 (C ω)"
    },
    {
      "start": 1227,
      "end": 1227,
      "text": "    let A : Ω → ℝ := fun ω => FA (C ω)"
    },
    {
      "start": 1228,
      "end": 1228,
      "text": "    let B : Ω → ℝ := fun ω => FB (C ω)"
    },
    {
      "start": 1229,
      "end": 1229,
      "text": "    let Adelete : Fin n → Ω → ℝ := fun i ω => FAdelete i (fun j => ζ j.1 ω)"
    },
    {
      "start": 1230,
      "end": 1230,
      "text": "    let Bdelete : Fin n → Ω → ℝ := fun i ω => FBdelete i (fun j => ζ j.1 ω)"
    },
    {
      "start": 1231,
      "end": 1231,
      "text": "    let W : Ω → ℝ := fun ω => ∑ i : Fin n, ζ i ω"
    },
    {
      "start": 1232,
      "end": 1232,
      "text": "    let V : Ω → ℝ := fun ω => Real.sqrt (∑ i : Fin n, (ζ i ω) ^ 2)"
    },
    {
      "start": 1233,
      "end": 1233,
      "text": "    let S : Ω → ℝ := fun ω => ∑ i : Fin n, (x * ζ i ω - (x * ζ i ω) ^ 2 / 2)"
    },
    {
      "start": 1234,
      "end": 1234,
      "text": "    let Sminus : Fin n → Ω → ℝ := fun i ω => ∑ j ∈ Finset.univ.erase i, (x * ζ j ω - (x * ζ j ω) ^ 2 / 2)"
    },
    {
      "start": 1235,
      "end": 1235,
      "text": "    let I : ℝ := ∫ ω, Real.exp (S ω) ∂ν"
    },
    {
      "start": 1236,
      "end": 1236,
      "text": "    let δ : Fin n → ℝ := fun i => ∫ ω, (x * ζ i ω) ^ 2 * min |x * ζ i ω| 1 ∂ν"
    },
    {
      "start": 1237,
      "end": 1237,
      "text": "    let L : ℝ := ∑ i : Fin n, δ i"
    },
    {
      "start": 1238,
      "end": 1238,
      "text": "    let full : Ω → ℝ := fun ω => (x * A ω + x ^ 2 * B ω) * Real.exp (S ω)"
    },
    {
      "start": 1239,
      "end": 1239,
      "text": "    let deleted : Fin n → Ω → ℝ := fun i ω => (min |x * ζ i ω| 1 * (|A ω - Adelete i ω| + x * |B ω - Bdelete i ω|)) * Real.exp (Sminus i ω)"
    },
    {
      "start": 1240,
      "end": 1240,
      "text": "    let R : ℝ := ((∫ ω, full ω ∂ν) + ∑ i : Fin n, ∫ ω, deleted i ω ∂ν) / I"
    },
    {
      "start": 1241,
      "end": 1241,
      "text": "    let T : Ω → ℝ := fun ω => (W ω + D1 ω) / (V ω * Real.sqrt (1 + D2 ω))"
    },
    {
      "start": 1242,
      "end": 1242,
      "text": "    (∀ ω : Ω, 0 ≤ A ω ∧ 0 ≤ B ω) →"
    },
    {
      "start": 1243,
      "end": 1243,
      "text": "    (∀ (i : Fin n) (ω : Ω), 0 ≤ Adelete i ω ∧ 0 ≤ Bdelete i ω) →"
    },
    {
      "start": 1244,
      "end": 1244,
      "text": "    (∀ᵐ ω ∂ν, |D1 ω| ≤ A ω ∧ |D2 ω| ≤ B ω) →"
    },
    {
      "start": 1245,
      "end": 1245,
      "text": "    (∀ᵐ ω ∂ν, 0 < 1 + D2 ω) →"
    },
    {
      "start": 1246,
      "end": 1246,
      "text": "    (∀ᵐ ω ∂ν, 0 < V ω) →"
    },
    {
      "start": 1247,
      "end": 1247,
      "text": "    Integrable (fun ω => Real.exp (S ω)) ν →"
    },
    {
      "start": 1248,
      "end": 1248,
      "text": "    0 < I → Integrable full ν →"
    },
    {
      "start": 1249,
      "end": 1249,
      "text": "    (∀ i : Fin n, Integrable (deleted i) ν) →"
    },
    {
      "start": 1250,
      "end": 1250,
      "text": "    1 ≤ x → (∀ i : Fin n, δ i ≤ 1) → L ≤ cSZ * x ^ 2 →"
    },
    {
      "start": 1251,
      "end": 1251,
      "text": "    Shao.standardNormalTail x * Real.exp (-C1 * L) * (1 - C2 * R) ≤"
    },
    {
      "start": 1252,
      "end": 1252,
      "text": "      ν.real {ω : Ω | x ≤ T ω} ∧"
    },
    {
      "start": 1253,
      "end": 1253,
      "text": "    ν.real {ω : Ω | x ≤ T ω} ≤"
    },
    {
      "start": 1254,
      "end": 1254,
      "text": "      Shao.standardNormalTail x * Real.exp (C3 * L) * (1 + C4 * R) +"
    },
    {
      "start": 1255,
      "end": 1255,
      "text": "        ν.real {ω : Ω | x * |D1 ω| > V ω / 4} +"
    },
    {
      "start": 1256,
      "end": 1256,
      "text": "        ν.real {ω : Ω | x ^ 2 * |D2 ω| > (1 / 4 : ℝ)}"
    },
    {
      "start": 1257,
      "end": 1257,
      "text": "end"
    },
    {
      "start": 1258,
      "end": 1258,
      "text": "end Shao.OQ6.NormalizedIntegrableTailAssembly"
    },
    {
      "start": 1259,
      "end": 1259,
      "text": "```"
