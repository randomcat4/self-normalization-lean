      "text": "  · simp [ha.le, hb.le, mabs_of_le_one, mul_le_one', mul_comm]"
    },
    {
      "start": 1288,
      "end": 1288,
      "text": "  have : (|a * b|ₘ = a⁻¹ * b ↔ b ≤ 1) ↔"
    },
    {
      "start": 1289,
      "end": 1289,
      "text": "    (|a * b|ₘ = |a|ₘ * |b|ₘ ↔ 1 ≤ a ∧ 1 ≤ b ∨ a ≤ 1 ∧ b ≤ 1) := by"
    },
    {
      "start": 1290,
      "end": 1290,
      "text": "    simp [ha.le, ha.not_ge, hb, mabs_of_le_one, mabs_of_one_le]"
    },
    {
      "start": 1291,
      "end": 1291,
      "text": "  refine this.mp ⟨fun h ↦ ?_, fun h ↦ by simp only [h.antisymm hb, mabs_of_lt_one ha, mul_one]⟩"
    },
    {
      "start": 1292,
      "end": 1292,
      "text": "  obtain ab | ab := le_or_gt (a * b) 1"
    },
    {
      "start": 1293,
      "end": 1293,
      "text": "  · refine (eq_one_of_inv_eq' ?_).le"
    },
    {
      "start": 1294,
      "end": 1294,
      "text": "    rwa [mabs_of_le_one ab, mul_inv_rev, mul_comm, mul_right_inj] at h"
    },
    {
      "start": 1295,
      "end": 1295,
      "text": "  · rw [mabs_of_one_lt ab, mul_left_inj] at h"
    },
    {
      "start": 1296,
      "end": 1296,
      "text": "    rw [eq_one_of_inv_eq' h.symm] at ha"
    },
    {
      "start": 1297,
      "end": 1297,
      "text": "    cases ha.false"
    },
    {
      "start": 1298,
      "end": 1298,
      "text": ""
    },
    {
      "start": 1299,
      "end": 1299,
      "text": "@[to_additive] lemma mabs_mul_eq_mul_mabs_iff (a b : G) :"
    },
    {
      "start": 1300,
      "end": 1300,
      "text": "    |a * b|ₘ = |a|ₘ * |b|ₘ ↔ 1 ≤ a ∧ 1 ≤ b ∨ a ≤ 1 ∧ b ≤ 1 := by"
