      "end": 1263,
      "text": "Binding: {\"path\":\"C:/game/shao lean/drafts/oq56/next-source/oq6-original-normalized-upper-204/author-stage1-01/primary-Mathlib_Algebra_Order_Group_Abs.lean-full.txt\",\"sha256\":\"7ee1b8dc36a470cef66c2f27858a8bcafa82f6903f5401c3a48a1b3a305020b1\",\"bytes\":10778}"
