    {
      "start": 1282,
      "end": 1282,
      "text": "    |a * b|ₘ = |a|ₘ * |b|ₘ ↔ 1 ≤ a ∧ 1 ≤ b ∨ a ≤ 1 ∧ b ≤ 1 := by"
    },
    {
      "start": 1283,
      "end": 1283,
      "text": "  obtain ha | ha := le_or_gt 1 a <;> obtain hb | hb := le_or_gt 1 b"
    },
    {
      "start": 1284,
      "end": 1284,
      "text": "  · simp [ha, hb, mabs_of_one_le, one_le_mul ha hb]"
    },
