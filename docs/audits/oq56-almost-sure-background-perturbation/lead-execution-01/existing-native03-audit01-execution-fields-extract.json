  "lockScopeSourceLines92to99": " mode=cfg['mode'];label=cfg['label'];assert re.fullmatch('[a-z][a-z0-9-]{0,40}',label)\n U=Path(cfg['unit_directory']).resolve();assert U.is_relative_to(R/'work/oq56') and U.is_dir()\n F=U/label;assert not F.exists()\n lock=(R/'work/oq56/HEAVY.lock').open('a+b');fcntl.flock(lock.fileno(),fcntl.LOCK_EX|fcntl.LOCK_NB)\n S=Path(cfg['source_path']).resolve();assert S.suffix=='.lean' and S.is_relative_to(R)\n if mode!='audit':assert S.is_relative_to(R/'Shao/OQ5') or S.is_relative_to(R/'Shao/OQ6')\n sb=S.read_bytes();assert len(sb)==cfg['source_bytes'] and hashlib.sha256(sb).hexdigest()==cfg['source_sha256'] and len(sb.splitlines())==cfg['source_lines']\n assert bytes([13]) not in sb and sb.endswith(bytes([10])) and not sb.endswith(bytes([10,10])) and not sb.startswith(bytes([239,187,191]))\n",
