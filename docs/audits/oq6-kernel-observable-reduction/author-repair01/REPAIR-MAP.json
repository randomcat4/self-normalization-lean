      "name": "exists_countably_generated_observable_subspace",
      "lines": 13,
      "head": "theorem exists_countably_generated_observable_subspace\n    {Ω : Type u} [mΩ : MeasurableSpace Ω]\n    (h : Ω → Ω → ℝ)\n    (hh : Measurable[mΩ.prod mΩ, borel ℝ]\n      (fun t : Ω × Ω => h t.1 t.2))\n    (f : ℕ → Ω → ℝ)\n    (hf : ∀ k : ℕ, Measurable[mΩ, borel ℝ] (f k)) :\n    ∃ m₀ : MeasurableSpace Ω,\n      m₀ ≤ mΩ ∧\n      @MeasurableSpace.CountablyGenerated Ω m₀ ∧\n      Measurable[m₀.prod m₀, borel ℝ]\n        (fun t : Ω × Ω => h t.1 t.2) ∧\n      ∀ k : ℕ, Measurable[m₀, borel ℝ] (f k)",
      "bytes": 553,
      "newExactOccurrenceCount": 1,
      "oldExactOccurrenceCount": 1,
      "actualSHA256": "979d93d9e583d1e2ae3a1f4f727e2c4d7181b7ae9cd204e4b686e747e83262d2"
    }
