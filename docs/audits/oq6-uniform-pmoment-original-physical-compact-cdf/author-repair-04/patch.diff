         add_le_add ((hClosedDiff x).trans hZfail) (add_le_add hClosed169 hMove)
       _ = error := by dsimp only [error]; ring
   have hopen : |P₀.real {ξ | T ξ < x} - Shao.OQ4.standardNormalCDF x| ≤ error := by
