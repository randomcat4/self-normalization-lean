-        add_le_add_left (abs_sub_le _ _ _) _
+        add_le_add (le_refl _) (abs_sub_le _ _ _)
       _ ≤ (Real.exp (-cg * N) + ((1 / 16 : ℝ) + 16720 * s) / q) +
