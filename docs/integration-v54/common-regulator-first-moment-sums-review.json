  "publicDeclarations": {
    "iid_lindleyRegulator_prefix_first_moment": {
      "declaration": "theorem iid_lindleyRegulator_prefix_first_moment\n    (ν : Measure ℝ) [IsProbabilityMeasure ν]\n    (h2 : Integrable (fun a : ℝ => a ^ 2) ν) (N : ℕ) (i : Fin N) :\n    let P : Measure (Shao.Path N) := Measure.pi (fun _ : Fin N => ν)\n    let μ : ℝ := ∫ a : ℝ, a ∂ν\n    let V : ℝ := variance (id : ℝ → ℝ) ν\n    Integrable (fun a : Shao.Path N => lindleyRegulator a i) P ∧\n      ((i.val + 1 : ℕ) : ℝ) *\n        (∫ a : Shao.Path N, lindleyRegulator a i ∂P) =\n          ∫ a : Shao.Path N, max (-(Shao.prefixSum a (i.val + 1))) 0 ∂P ∧\n      (∫ a : Shao.Path N, lindleyRegulator a i ∂P) ≤\n        Real.sqrt V / Real.sqrt ((i.val + 1 : ℕ) : ℝ) + |μ|",
      "declarationSHA256": "b4d408d8462993d24781ab0f37633926016f5f1c54ee0d0e03c383dec20f4d92",
      "literalFrozenMatch": true,
      "verdict": "CORRECT"
    },
    "iid_lindleyRegulator_sum_first_moment": {
      "declaration": "theorem iid_lindleyRegulator_sum_first_moment\n    (ν : Measure ℝ) [IsProbabilityMeasure ν]\n    (h2 : Integrable (fun a : ℝ => a ^ 2) ν) (N : ℕ) :\n    let P : Measure (Shao.Path N) := Measure.pi (fun _ : Fin N => ν)\n    let μ : ℝ := ∫ a : ℝ, a ∂ν\n    let V : ℝ := variance (id : ℝ → ℝ) ν\n    Integrable (fun a : Shao.Path N => ∑ i : Fin N, lindleyRegulator a i) P ∧\n      (∫ a : Shao.Path N, ∑ i : Fin N, lindleyRegulator a i ∂P) ≤\n        2 * Real.sqrt V * Real.sqrt (N : ℝ) + (N : ℝ) * |μ|",
      "declarationSHA256": "973161f1b4ef2edde1a95264791210f80d1c99fc32aa2a949c73f9debdd2cf51",
      "literalFrozenMatch": true,
      "verdict": "CORRECT"
    }
  },
