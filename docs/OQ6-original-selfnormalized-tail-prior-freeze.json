      "kind": "theorem",
      "name": "original_selfnormalized_tail",
      "qualifiedName": "Shao.OQ6.OriginalSelfNormalizedTail.original_selfnormalized_tail",
      "head": "theorem original_selfnormalized_tail\n    (n : ℕ) {Ω : Type*} [mΩ : MeasurableSpace Ω]\n    (μ : Measure Ω) [hμ : IsProbabilityMeasure μ]\n    (g : Ω → ℝ) (hg : Measurable g) (hg2 : MemLp g 2 μ)\n    (hgmean : (∫ o : Ω, g o ∂μ) = 0)\n    (hgsecond : (∫ o : Ω, (g o) ^ (2 : ℕ) ∂μ) = 1)\n    (t : ℝ) (ht : (1 : ℝ) ≤ t) :\n    (Shao.OQ6.CanonicalDoubleGhostRowMoments.sampleLaw n μ).real\n      {x : Fin n → Ω |\n        t * (Real.sqrt (Shao.OQ6.OriginalGhostGoodEvent.sampleEnergy n g x) +\n          (4 : ℝ) * Real.sqrt (n : ℝ)) <\n            |Shao.OQ6.OriginalGhostGoodEvent.sampleSum n g x|} ≤\n      (4 : ℝ) * Real.exp (-(t ^ (2 : ℕ)) / (2 : ℝ))",
      "headSHA256": "2e0d3d2e7cb0d5323198e82c8d26d824f842f80fb5943a288a794e8acde34f15",
      "headBytes": 687,
      "normalization": "Exact candidate JSON string encoded UTF-8; no terminal newline in hash; no proof body.",
      "public": true
    }
