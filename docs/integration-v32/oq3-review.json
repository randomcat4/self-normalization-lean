    "selected_apis": {
      "Mathlib/Analysis/Convex/SpecificFunctions/Basic.lean:62": "/-- `Real.exp` is convex on the whole real line. -/\ntheorem convexOn_exp : ConvexOn ℝ univ exp :=\n  strictConvexOn_exp.convexOn\n\n/-- `Real.log` is strictly concave on `(0, +∞)`. -/",
      "Mathlib/Analysis/Convex/SpecificFunctions/Basic.lean:212": "theorem convexOn_rpow_left {b : ℝ} (hb : 0 < b) : ConvexOn ℝ Set.univ (fun (x : ℝ) => b ^ x) := by\n  convert! convexOn_exp.comp_linearMap (LinearMap.mul ℝ ℝ (Real.log b)) using 1\n  ext x\n  simp [Real.rpow_def_of_pos hb]\n",
      "Mathlib/Analysis/Convex/SpecificFunctions/Basic.lean:236": "    _ ≤ (1 + t) / 2 * exp x + (1 - t) / 2 * exp (-x) :=\n        convexOn_exp.2 (Set.mem_univ _) (Set.mem_univ _) (by linarith) (by linarith) <| by ring\n    _ = _ := by rw [cosh_eq, sinh_eq]; ring\n\nend Real",
      "Mathlib/MeasureTheory/Integral/Bochner/Basic.lean:50": "  * `integral_nonpos_of_ae` : `f ≤ᵐ[μ] 0 → ∫ x, f x ∂μ ≤ 0`\n  * `integral_mono_ae`      : `f ≤ᵐ[μ] g → ∫ x, f x ∂μ ≤ ∫ x, g x ∂μ`\n  * `integral_nonneg`       : `0 ≤ f → 0 ≤ ∫ x, f x ∂μ`\n  * `integral_nonpos`       : `f ≤ 0 → ∫ x, f x ∂μ ≤ 0`\n  * `integral_mono`         : `f ≤ᵐ[μ] g → ∫ x, f x ∂μ ≤ ∫ x, g x ∂μ`",
      "Mathlib/MeasureTheory/Integral/Bochner/Basic.lean:662": "\nlemma integral_mono_ae {f g : α → E} (hf : Integrable f μ) (hg : Integrable g μ)\n    (h : f ≤ᵐ[μ] g) : ∫ x, f x ∂μ ≤ ∫ x, g x ∂μ := by\n  rw [← sub_nonneg, ← integral_sub hg hf]\n  refine integral_nonneg_of_ae ?_",
      "Mathlib/MeasureTheory/Integral/Bochner/Basic.lean:672": "    (h : f ≤ g) : ∫ x, f x ∂μ ≤ ∫ x, g x ∂μ :=\n  integral_mono_ae hf hg (ae_of_all _ h)\n\nlemma integral_mono_of_nonneg {f g : α → E} (hf : 0 ≤ᵐ[μ] f) (hgi : Integrable g μ)\n    (h : f ≤ᵐ[μ] g) : ∫ a, f a ∂μ ≤ ∫ a, g a ∂μ := by",
      "Mathlib/MeasureTheory/Integral/Bochner/Basic.lean:677": "  by_cases hfi : Integrable f μ\n  · exact integral_mono_ae hfi hgi h\n  · exact integral_undef hfi ▸ integral_nonneg_of_ae (hf.trans h)\n\nlemma integral_monotoneOn_of_integrand_ae {β : Type*} [Preorder β] {f : α → β → E}",
      "Mathlib/MeasureTheory/Integral/Bochner/Basic.lean:684": "  intro a ha b hb hab\n  refine integral_mono_ae (hf_int a ha) (hf_int b hb) ?_\n  filter_upwards [hf_mono] with x hx\n  exact hx ha hb hab\n",
      "Mathlib/MeasureTheory/Integral/Bochner/Basic.lean:692": "  intro a ha b hb hab\n  refine integral_mono_ae (hf_int b hb) (hf_int a ha) ?_\n  filter_upwards [hf_anti] with x hx\n  exact hx ha hb hab\n",
      "Mathlib/MeasureTheory/Integral/Bochner/Basic.lean:703": "  calc ∫ x, f x (p • a + q • b) ∂μ ≤ ∫ x, p • f x a + q • f x b ∂μ := by\n                  refine integral_mono_ae ?lhs ?rhs ?ae_le\n                  case lhs =>\n                    refine hf_int _ ?_\n                    rw [convex_iff_add_mem] at hs",
      "Mathlib/MeasureTheory/Integral/Bochner/Basic.lean:792": "\nlemma integral_exp_pos {μ : Measure α} {f : α → ℝ} [hμ : NeZero μ]\n    (hf : Integrable (fun x ↦ Real.exp (f x)) μ) :\n    0 < ∫ x, Real.exp (f x) ∂μ := by\n  rw [integral_pos_iff_support_of_nonneg (fun x ↦ (Real.exp_pos _).le) hf]",
      "Mathlib/MeasureTheory/Integral/Bochner/Basic.lean:1177": "      _ ≤ ∫ x in {x | ε ≤ f x}, f x ∂μ :=\n        integral_mono_ae (integrable_const _) (hf_int.mono_measure μ.restrict_le_self) <|\n          ae_restrict_mem₀ <| hf_int.aemeasurable.nullMeasurable measurableSet_Ici\n      _ ≤ _ := integral_mono_measure μ.restrict_le_self hf_nonneg hf_int\n",
