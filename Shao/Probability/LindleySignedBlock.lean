import Shao.Probability.LindleyTelescoping

/-!
# History-localized signed blocks of Lindley reflection defects

History is the genuine sigma algebra of the original first observations.
The weighted one-step identity is proved under the original iid product law;
no independence assertion is made under a measure restricted to an event.
-/

set_option autoImplicit false

namespace Shao.Probability

open MeasureTheory ProbabilityTheory
open scoped BigOperators

/-- The exact sigma algebra generated by the first `k` original increments. -/
@[instance_reducible] def lindleyHistory {n : ℕ} {Ω : Type*}
    (X : Fin n → Ω → ℝ) (k : ℕ) (hk : k ≤ n) : MeasurableSpace Ω :=
  MeasurableSpace.comap
    (fun ω => Shao.prefixPath (fun i => X i ω) k hk)
    (inferInstance : MeasurableSpace (Shao.Path k))

theorem lindleyHistory_eq_iSup {n : ℕ} {Ω : Type*}
    (X : Fin n → Ω → ℝ) (k : ℕ) (hk : k ≤ n) :
    lindleyHistory X k hk =
      ⨆ j : Fin k,
        MeasurableSpace.comap
          (X ⟨j.val, lt_of_lt_of_le j.is_lt hk⟩)
          (inferInstance : MeasurableSpace ℝ) := by
  simp only [lindleyHistory, MeasurableSpace.pi, MeasurableSpace.comap_iSup,
    MeasurableSpace.comap_comp, Function.comp_def, Shao.prefixPath]

private theorem measurable_prefix {n : ℕ} (k : ℕ) (hk : k ≤ n) :
    Measurable (fun a : Shao.Path n => Shao.prefixPath a k hk) :=
  Measurable.of_eval (fun _j => measurable_pi_apply _)

private theorem measurable_state {n : ℕ} (k : ℕ) (hk : k ≤ n) :
    Measurable (fun a : Shao.Path n => Shao.lindleyState a k hk) := by
  have hr : Measurable (Shao.reversePath : Shao.Path k → Shao.Path k) :=
    Measurable.of_eval (fun j => measurable_pi_apply _)
  simpa only [Shao.lindleyState_eq_maxWithZero_reverse_prefix, Function.comp_def] using
    Shao.measurable_maxWithZero.comp (hr.comp (measurable_prefix k hk))

private theorem integrable_unit_bounded {α : Type*} [MeasurableSpace α]
    (ρ : Measure α) [IsFiniteMeasure ρ] {f : α → ℝ} (hf : Measurable f)
    (h01 : ∀ z, 0 ≤ f z ∧ f z ≤ 1) : Integrable f ρ := by
  apply (integrable_const (1 : ℝ)).mono' hf.aestronglyMeasurable
  exact ae_of_all ρ (fun z => by
    rw [Real.norm_eq_abs, abs_of_nonneg (h01 z).1]
    exact (h01 z).2)

private theorem integrable_future_composition {α : Type*} [MeasurableSpace α]
    (ρ : Measure α) [IsFiniteMeasure ρ] (ν : Measure ℝ) [IsProbabilityMeasure ν]
    (l : ℕ) (ψ : ℝ × ℝ → ℝ) (hψ : Measurable ψ)
    (hψ01 : ∀ s, 0 ≤ ψ s ∧ ψ s ≤ 1)
    (s : α → ℝ × ℝ) (hs : Measurable s) :
    Integrable (fun z => lindleyFutureKernel ν l ψ (s z)) ρ :=
  integrable_unit_bounded ρ ((measurable_lindleyFutureKernel ν l ψ hψ).comp hs)
    (fun z => lindleyFutureKernel_bounds ν l ψ hψ hψ01 (s z))

private theorem prefixSquares_succ_at {n : ℕ} (a : Shao.Path n) (i : Fin n) :
    Shao.prefixSquares a (i.val + 1) = Shao.prefixSquares a i.val + (a i) ^ 2 := by
  have hf : Finset.univ.filter (fun j : Fin n => j.val < i.val + 1) =
      insert i (Finset.univ.filter (fun j : Fin n => j.val < i.val)) := by
    ext j
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_insert]
    constructor
    · intro h
      rcases lt_or_eq_of_le (Nat.lt_succ_iff.mp h) with hlt | heq
      · exact Or.inr hlt
      · exact Or.inl (Fin.ext heq)
    · rintro (h | h)
      · subst j
        exact Nat.lt_succ_self _
      · exact Nat.lt_succ_of_lt h
  unfold Shao.prefixSquares
  rw [hf, Finset.sum_insert]
  · exact add_comm _ _
  · simp

private theorem state_prefix_congr {n : ℕ} (a b : Shao.Path n) (k : ℕ)
    (hk : k ≤ n) (hab : ∀ j : Fin n, j.val < k → a j = b j) :
    Shao.lindleyState a k hk = Shao.lindleyState b k hk := by
  have hp : Shao.prefixPath a k hk = Shao.prefixPath b k hk := by
    funext j
    exact hab _ j.is_lt
  rw [Shao.lindleyState_eq_maxWithZero_reverse_prefix,
    Shao.lindleyState_eq_maxWithZero_reverse_prefix, hp]

private theorem squares_prefix_congr {n : ℕ} (a b : Shao.Path n) (k : ℕ)
    (hab : ∀ j : Fin n, j.val < k → a j = b j) :
    Shao.prefixSquares a k = Shao.prefixSquares b k := by
  apply Finset.sum_congr rfl
  intro j hj
  rw [hab j (Finset.mem_filter.mp hj).2]

private theorem state_insertNth {n : ℕ} (i : Fin (n + 1))
    (z : ℝ) (b : Shao.Path n) :
    Shao.lindleyState (Fin.insertNth i z b) i.val (Nat.le_of_lt i.is_lt) =
      Shao.lindleyState (Fin.insertNth i 0 b) i.val (Nat.le_of_lt i.is_lt) := by
  apply state_prefix_congr
  intro j hj
  simp only [Fin.insertNth_apply_below (show j < i from hj)]

private theorem squares_insertNth {n : ℕ} (i : Fin (n + 1))
    (z : ℝ) (b : Shao.Path n) :
    Shao.prefixSquares (Fin.insertNth i z b) i.val =
      Shao.prefixSquares (Fin.insertNth i 0 b) i.val := by
  apply squares_prefix_congr
  intro j hj
  simp only [Fin.insertNth_apply_below (show j < i from hj)]

private theorem prefix_insertNth {n : ℕ} (i : Fin (n + 1))
    (k : ℕ) (hk : k ≤ n + 1) (hi : k ≤ i.val) (z : ℝ) (b : Shao.Path n) :
    Shao.prefixPath (Fin.insertNth i z b) k hk =
      Shao.prefixPath (Fin.insertNth i 0 b) k hk := by
  funext j
  dsimp only [Shao.prefixPath]
  have hj : (⟨j.val, lt_of_lt_of_le j.is_lt hk⟩ : Fin (n + 1)) < i := by
    change j.val < i.val
    exact lt_of_lt_of_le j.is_lt hi
  simp only [Fin.insertNth_apply_below hj]

private theorem integral_pi_insertNth {n : ℕ} (ν : Measure ℝ)
    [IsProbabilityMeasure ν] (F : Shao.Path (n + 1) → ℝ) (hF : Measurable F)
    (hF01 : ∀ a, 0 ≤ F a ∧ F a ≤ 1) (i : Fin (n + 1)) :
    (∫ a : Shao.Path (n + 1), F a ∂Measure.pi (fun _ : Fin (n + 1) => ν)) =
      ∫ b : Shao.Path n, ∫ z : ℝ, F (Fin.insertNth i z b) ∂ν
        ∂Measure.pi (fun _ : Fin n => ν) := by
  have hp := (measurePreserving_piFinSuccAbove (fun _ : Fin (n + 1) => ν) i).symm
  have hm : Measurable (fun p : ℝ × Shao.Path n => F (Fin.insertNth i p.1 p.2)) := by
    simpa only [Function.comp_def, MeasurableEquiv.piFinSuccAbove_symm_apply,
      Fin.insertNthEquiv_apply] using hF.comp hp.measurable
  calc
    _ = ∫ p : ℝ × Shao.Path n, F (Fin.insertNth i p.1 p.2)
        ∂ν.prod (Measure.pi (fun _ : Fin n => ν)) := by
      rw [← hp.integral_comp']
      rfl
    _ = _ := integral_prod_symm _
      (integrable_unit_bounded _ hm (fun p => hF01 _))

private theorem sum_fin_successive_sub {n : ℕ} (f : Fin (n + 1) → ℝ) :
    (∑ i : Fin n, (f i.succ - f i.castSucc)) = f (Fin.last n) - f 0 := by
  rw [Finset.sum_sub_distrib]
  have hfirst := Fin.sum_univ_succ f
  have hlast := Fin.sum_univ_castSucc f
  linarith

private theorem sum_fin_tail_sub {n : ℕ} (f : Fin (n + 1) → ℝ)
    (k : ℕ) (hk : k ≤ n) :
    (∑ i : Fin n, if k ≤ i.val then f i.succ - f i.castSucc else 0) =
      f (Fin.last n) - f ⟨k, Nat.lt_succ_of_le hk⟩ := by
  let G : Fin (n + 1) → ℝ := fun j =>
    f ⟨max k j.val, Nat.lt_succ_of_le
      (max_le hk (Nat.le_of_lt_succ j.is_lt))⟩
  have hterm (i : Fin n) : G i.succ - G i.castSucc =
      if k ≤ i.val then f i.succ - f i.castSucc else 0 := by
    by_cases hi : k ≤ i.val
    · have hs : k ≤ i.val + 1 := Nat.le_succ_of_le hi
      simp only [G, Fin.val_succ, Fin.val_castSucc, max_eq_right hi,
        max_eq_right hs, ite_eq_left hi]
      rfl
    · have hs : i.val + 1 ≤ k := Nat.succ_le_of_lt (Nat.lt_of_not_ge hi)
      have hc : i.val ≤ k := (Nat.le_succ i.val).trans hs
      simp only [G, Fin.val_succ, Fin.val_castSucc, max_eq_left hc,
        max_eq_left hs, ite_eq_right hi, sub_self]
  calc
    _ = ∑ i : Fin n, (G i.succ - G i.castSucc) :=
      Finset.sum_congr rfl (fun i _ => (hterm i).symm)
    _ = G (Fin.last n) - G 0 := sum_fin_successive_sub G
    _ = _ := by
      simp [G, max_eq_right hk]
      rfl

section IID

variable {n : ℕ} {Ω : Type*} [MeasurableSpace Ω]
variable {μ : Measure Ω} {ν : Measure ℝ}
variable [hμ : IsProbabilityMeasure μ] [hν : IsProbabilityMeasure ν]
variable {X : Fin n → Ω → ℝ}
include hμ hν

private theorem iid_integral_path
    (hX : ∀ i, Measurable (X i)) (hIndep : iIndepFun X μ)
    (hLaw : ∀ i, IdentDistrib (X i) (id : ℝ → ℝ) μ ν)
    (F : Shao.Path n → ℝ) (hF : Measurable F) :
    (∫ ω, F (samplePath X ω) ∂μ) =
      ∫ a : Shao.Path n, F a ∂Measure.pi (fun _ : Fin n => ν) := by
  simpa only [Function.comp_def, id_eq] using
    ((iid_samplePath_identDistrib hX hIndep hLaw).comp hF).integral_eq

/-- The event is measurable before the separated increment. All averaging
uses the original iid product measure, with the genuine prefix indicator. -/
theorem iid_lindley_future_step_on_history
    (hX : ∀ i, Measurable (X i)) (hIndep : iIndepFun X μ)
    (hLaw : ∀ i, IdentDistrib (X i) (id : ℝ → ℝ) μ ν)
    (k : ℕ) (hk : k ≤ n) (E : Set Ω)
    (hE : MeasurableSet[lindleyHistory X k hk] E)
    (ψ : ℝ × ℝ → ℝ) (hψ : Measurable ψ)
    (hψ01 : ∀ s, 0 ≤ ψ s ∧ ψ s ≤ 1)
    (i : Fin n) (hi : k ≤ i.val) :
    (∫ ω in E, lindleyFutureKernel ν (n - (i.val + 1)) ψ
        (Shao.lindleyState (samplePath X ω) i.val
            (Nat.le_of_lt i.is_lt) + X i ω,
          Shao.prefixSquares (samplePath X ω) (i.val + 1)) ∂μ) =
      ∫ ω in E, lindleyFutureKernel ν (n - i.val) ψ
        (Shao.lindleyState (samplePath X ω) i.val
            (Nat.le_of_lt i.is_lt),
          Shao.prefixSquares (samplePath X ω) i.val) ∂μ := by
  change ∃ B : Set (Shao.Path k), MeasurableSet B ∧
    (fun ω => Shao.prefixPath (fun j => X j ω) k hk) ⁻¹' B = E at hE
  rcases hE with ⟨B, hB, rfl⟩
  cases n with
  | zero => exact Fin.elim0 i
  | succ m =>
    let P : Set (Shao.Path (m + 1)) := {a | Shao.prefixPath a k hk ∈ B}
    have hP : MeasurableSet P := hB.preimage (measurable_prefix k hk)
    have hEamb : MeasurableSet
        ((fun ω => Shao.prefixPath (fun j => X j ω) k hk) ⁻¹' B) :=
      hB.preimage ((measurable_prefix k hk).comp (measurable_samplePath hX))
    let L : Shao.Path (m + 1) → ℝ := fun a =>
      lindleyFutureKernel ν (m + 1 - (i.val + 1)) ψ
        (Shao.lindleyState a i.val (Nat.le_of_lt i.is_lt) + a i,
          Shao.prefixSquares a (i.val + 1))
    let R : Shao.Path (m + 1) → ℝ := fun a =>
      lindleyFutureKernel ν (m + 1 - i.val) ψ
        (Shao.lindleyState a i.val (Nat.le_of_lt i.is_lt), Shao.prefixSquares a i.val)
    have hL : Measurable L := (measurable_lindleyFutureKernel ν _ ψ hψ).comp
      (((measurable_state i.val _).add (measurable_pi_apply i)).prodMk
        (Shao.measurable_prefixSquares (i.val + 1)))
    have hR : Measurable R := (measurable_lindleyFutureKernel ν _ ψ hψ).comp
      ((measurable_state i.val _).prodMk (Shao.measurable_prefixSquares i.val))
    have hL01 : ∀ a, 0 ≤ L a ∧ L a ≤ 1 := fun a =>
      lindleyFutureKernel_bounds ν _ ψ hψ hψ01 _
    have hR01 : ∀ a, 0 ≤ R a ∧ R a ≤ 1 := fun a =>
      lindleyFutureKernel_bounds ν _ ψ hψ hψ01 _
    let LW := P.indicator L
    let RW := P.indicator R
    have hLW : Measurable LW := hL.indicator hP
    have hRW : Measurable RW := hR.indicator hP
    have hLW01 : ∀ a, 0 ≤ LW a ∧ LW a ≤ 1 := by
      intro a
      by_cases ha : a ∈ P
      · simpa only [LW, Set.indicator_of_mem ha] using hL01 a
      · simp [LW, ha]
    have hRW01 : ∀ a, 0 ≤ RW a ∧ RW a ≤ 1 := by
      intro a
      by_cases ha : a ∈ P
      · simpa only [RW, Set.indicator_of_mem ha] using hR01 a
      · simp [RW, ha]
    rw [← integral_indicator hEamb, ← integral_indicator hEamb]
    change (∫ ω, LW (samplePath X ω) ∂μ) = ∫ ω, RW (samplePath X ω) ∂μ
    rw [iid_integral_path hX hIndep hLaw LW hLW,
      iid_integral_path hX hIndep hLaw RW hRW,
      integral_pi_insertNth ν LW hLW hLW01 i,
      integral_pi_insertNth ν RW hRW hRW01 i]
    apply integral_congr_ae
    exact ae_of_all _ (fun b => by
      have hcore : (∫ z : ℝ, L (Fin.insertNth i z b) ∂ν) =
          ∫ z : ℝ, R (Fin.insertNth i z b) ∂ν := by
        have hlen : m + 1 - i.val = (m + 1 - (i.val + 1)) + 1 := by omega
        calc
          _ = ∫ z : ℝ, lindleyFutureKernel ν (m + 1 - (i.val + 1)) ψ
              (Shao.lindleyState (Fin.insertNth i 0 b) i.val
                  (Nat.le_of_lt i.is_lt) + z,
                Shao.prefixSquares (Fin.insertNth i 0 b) i.val + z ^ 2) ∂ν := by
            apply integral_congr_ae
            exact ae_of_all ν (fun z => by
              dsimp [L]
              rw [prefixSquares_succ_at, Fin.insertNth_apply_same,
                state_insertNth, squares_insertNth])
          _ = lindleyFutureKernel ν (m + 1 - i.val) ψ
              (Shao.lindleyState (Fin.insertNth i 0 b) i.val (Nat.le_of_lt i.is_lt),
                Shao.prefixSquares (Fin.insertNth i 0 b) i.val) := by
            rw [hlen, lindleyFutureKernel_succ ν _ ψ hψ hψ01]
          _ = _ := by
            simp only [R, state_insertNth, squares_insertNth]
            simp [integral_const, measureReal_def]
      have hPconst (z : ℝ) : Fin.insertNth i z b ∈ P ↔ Fin.insertNth i 0 b ∈ P := by
        change Shao.prefixPath (Fin.insertNth i z b) k hk ∈ B ↔
          Shao.prefixPath (Fin.insertNth i 0 b) k hk ∈ B
        rw [prefix_insertNth i k hk hi z b]
      by_cases hb : Fin.insertNth i 0 b ∈ P
      · calc
          _ = ∫ z : ℝ, L (Fin.insertNth i z b) ∂ν := by
            apply integral_congr_ae
            exact ae_of_all ν (fun z => Set.indicator_of_mem ((hPconst z).mpr hb) L)
          _ = ∫ z : ℝ, R (Fin.insertNth i z b) ∂ν := hcore
          _ = _ := by
            symm
            apply integral_congr_ae
            exact ae_of_all ν (fun z => Set.indicator_of_mem ((hPconst z).mpr hb) R)
      · calc
          _ = ∫ _z : ℝ, (0 : ℝ) ∂ν := by
            apply integral_congr_ae
            exact ae_of_all ν (fun z =>
              Set.indicator_of_notMem (fun hz => hb ((hPconst z).mp hz)) L)
          _ = _ := by
            symm
            apply integral_congr_ae
            exact ae_of_all ν (fun z =>
              Set.indicator_of_notMem (fun hz => hb ((hPconst z).mp hz)) R))

/-- A genuine signed late block equals one endpoint difference in expectation.
The event is measured at the beginning of the block, not in its future. -/
theorem iid_lindley_signedBlock_identity
    (hX : ∀ i, Measurable (X i)) (hIndep : iIndepFun X μ)
    (hLaw : ∀ i, IdentDistrib (X i) (id : ℝ → ℝ) μ ν)
    (k : ℕ) (hk : k ≤ n) (E : Set Ω)
    (hE : MeasurableSet[lindleyHistory X k hk] E)
    (ψ : ℝ × ℝ → ℝ) (hψ : Measurable ψ)
    (hψ01 : ∀ s, 0 ≤ ψ s ∧ ψ s ≤ 1) :
    (∫ ω in E,
        (∑ i : Fin n, if k ≤ i.val then
          lindleyDelta ν ψ (samplePath X ω) i else 0) ∂μ) =
      ∫ ω in E,
        (ψ (Shao.lindleyState (samplePath X ω) n le_rfl,
            Shao.energy (samplePath X ω)) -
          lindleyFutureKernel ν (n - k) ψ
            (Shao.lindleyState (samplePath X ω) k hk,
              Shao.prefixSquares (samplePath X ω) k)) ∂μ := by
  let T : Fin (n + 1) → ℝ := fun j =>
    ∫ ω in E, lindleyFutureKernel ν (n - j.val) ψ
      (Shao.lindleyState (samplePath X ω) j.val (Nat.le_of_lt_succ j.is_lt),
        Shao.prefixSquares (samplePath X ω) j.val) ∂μ
  have hs := measurable_samplePath hX
  have hstep (i : Fin n) (hi : k ≤ i.val) : T i.succ - T i.castSucc =
      ∫ ω in E, lindleyDelta ν ψ (samplePath X ω) i ∂μ := by
    have hcurr := integrable_future_composition (μ.restrict E) ν
      (n - (i.val + 1)) ψ hψ hψ01
      (fun ω => (Shao.lindleyState (samplePath X ω) (i.val + 1)
          (Nat.succ_le_of_lt i.is_lt),
        Shao.prefixSquares (samplePath X ω) (i.val + 1)))
      (((measurable_state (i.val + 1) (Nat.succ_le_of_lt i.is_lt)).comp hs).prodMk
        ((Shao.measurable_prefixSquares (i.val + 1)).comp hs))
    have hpre := integrable_future_composition (μ.restrict E) ν
      (n - (i.val + 1)) ψ hψ hψ01
      (fun ω => (Shao.lindleyState (samplePath X ω) i.val
          (Nat.le_of_lt i.is_lt) + X i ω,
        Shao.prefixSquares (samplePath X ω) (i.val + 1)))
      ((((measurable_state i.val (Nat.le_of_lt i.is_lt)).comp hs).add (hX i)).prodMk
        ((Shao.measurable_prefixSquares (i.val + 1)).comp hs))
    have hsingle := iid_lindley_future_step_on_history hX hIndep hLaw
      k hk E hE ψ hψ hψ01 i hi
    change (∫ ω in E, lindleyFutureKernel ν (n - (i.val + 1)) ψ
        (Shao.lindleyState (samplePath X ω) (i.val + 1) _,
          Shao.prefixSquares (samplePath X ω) (i.val + 1)) ∂μ) -
      (∫ ω in E, lindleyFutureKernel ν (n - i.val) ψ
        (Shao.lindleyState (samplePath X ω) i.val _,
          Shao.prefixSquares (samplePath X ω) i.val) ∂μ) = _
    rw [← hsingle, ← integral_sub hcurr hpre]
    apply integral_congr_ae
    exact ae_of_all (μ.restrict E) (fun ω => by
      dsimp only
      rw [Shao.lindleyState_succ]
      simpa only [lindleyDelta, lindleyRegulator, samplePath] using
        lindley_reflection_defect (lindleyFutureKernel ν (n - (i.val + 1)) ψ)
          (Shao.lindleyState (samplePath X ω) i.val (Nat.le_of_lt i.is_lt) + X i ω)
          (Shao.prefixSquares (samplePath X ω) (i.val + 1)))
  have hlast : T (Fin.last n) = ∫ ω in E, ψ
      (Shao.lindleyState (samplePath X ω) n le_rfl,
        Shao.energy (samplePath X ω)) ∂μ := by
    simp [T, lindleyFutureKernel_zero]
  have hint := integrable_lindley_test_and_delta (μ := μ) (ν := ν) hX ψ hψ hψ01
  have hmasked (i : Fin n) : Integrable
      (fun ω => if k ≤ i.val then lindleyDelta ν ψ (samplePath X ω) i else 0)
      (μ.restrict E) := by
    by_cases hi : k ≤ i.val
    · simpa only [ite_eq_left hi, IntegrableOn] using (hint.2.2 i).integrableOn (s := E)
    · simpa only [ite_eq_right hi] using
        (integrable_const (0 : ℝ) : Integrable (fun _ : Ω => (0 : ℝ)) (μ.restrict E))
  have hterminal := hint.1.integrableOn (s := E)
  have hstart := integrable_future_composition (μ.restrict E) ν (n - k) ψ hψ hψ01
    (fun ω => (Shao.lindleyState (samplePath X ω) k hk,
      Shao.prefixSquares (samplePath X ω) k))
    (((measurable_state k hk).comp hs).prodMk ((Shao.measurable_prefixSquares k).comp hs))
  calc
    _ = ∑ i : Fin n, if k ≤ i.val then
        (∫ ω in E, lindleyDelta ν ψ (samplePath X ω) i ∂μ) else 0 := by
      rw [integral_finsetSum Finset.univ (fun i _ => hmasked i)]
      apply Finset.sum_congr rfl
      intro i _
      by_cases hi : k ≤ i.val <;> simp only [hi, ite_true, ite_false, integral_zero]
    _ = ∑ i : Fin n, if k ≤ i.val then T i.succ - T i.castSucc else 0 := by
      apply Finset.sum_congr rfl
      intro i _
      by_cases hi : k ≤ i.val
      · rw [ite_eq_left hi, ite_eq_left hi, hstep i hi]
      · rw [ite_eq_right hi, ite_eq_right hi]
    _ = T (Fin.last n) - T ⟨k, Nat.lt_succ_of_le hk⟩ := sum_fin_tail_sub T k hk
    _ = _ := by
      rw [integral_sub hterminal hstart, ← hlast]

/-- An entire signed block costs at most the actual probability of the
history event. Absolute values remain outside the block integral. -/
theorem iid_lindley_signedBlock_bound
    (hX : ∀ i, Measurable (X i)) (hIndep : iIndepFun X μ)
    (hLaw : ∀ i, IdentDistrib (X i) (id : ℝ → ℝ) μ ν)
    (k : ℕ) (hk : k ≤ n) (E : Set Ω)
    (hE : MeasurableSet[lindleyHistory X k hk] E)
    (ψ : ℝ × ℝ → ℝ) (hψ : Measurable ψ)
    (hψ01 : ∀ s, 0 ≤ ψ s ∧ ψ s ≤ 1) :
    |∫ ω in E,
        (∑ i : Fin n, if k ≤ i.val then
          lindleyDelta ν ψ (samplePath X ω) i else 0) ∂μ| ≤
      (μ E).toReal := by
  rw [iid_lindley_signedBlock_identity hX hIndep hLaw k hk E hE ψ hψ hψ01]
  have hnorm (ω : Ω) : ‖ψ (Shao.lindleyState (samplePath X ω) n le_rfl,
      Shao.energy (samplePath X ω)) -
      lindleyFutureKernel ν (n - k) ψ
        (Shao.lindleyState (samplePath X ω) k hk,
          Shao.prefixSquares (samplePath X ω) k)‖ ≤ 1 := by
    rw [Real.norm_eq_abs, abs_le]
    have hA := hψ01 (Shao.lindleyState (samplePath X ω) n le_rfl,
      Shao.energy (samplePath X ω))
    have hB := lindleyFutureKernel_bounds ν (n - k) ψ hψ hψ01
      (Shao.lindleyState (samplePath X ω) k hk,
        Shao.prefixSquares (samplePath X ω) k)
    constructor <;> linarith only [hA.1, hA.2, hB.1, hB.2]
  have h := norm_setIntegral_le_of_norm_le_const_ae (measure_lt_top μ E)
    (ae_of_all (μ.restrict E) hnorm)
  simpa only [Real.norm_eq_abs, one_mul, measureReal_def] using h

end IID

end Shao.Probability
